# =============================================================================
# Fill from Supabase Dashboard → Project Settings → API
# Copy finished values into .env (do not commit .env)
# =============================================================================

SUPABASE_URL=
# Example: https://abcdefghijklmnop.supabase.co

SUPABASE_ANON_KEY=
# "anon" / "public" key — used for auth API calls from this backend

SUPABASE_SERVICE_ROLE_KEY=
# "service_role" key — server only (account deletion)

SUPABASE_JWT_SECRET=
# JWT Settings → JWT Secret (validates access tokens on /me, etc.)

# --- App (not from Supabase) ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false

# Add these under Authentication → URL Configuration → Redirect URLs
EMAIL_VERIFICATION_REDIRECT_URL=http://localhost:3000/auth/verify-email
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/auth/reset-password

AUTH_HTTP_TIMEOUT_SECONDS=10.0

# Supabase checklist (browser):
# [ ] Authentication → Providers → Email enabled
# [ ] Authentication → Settings → Confirm email ON or OFF
# [ ] Authentication → URL Configuration → Site URL + Redirect URLs
# [ ] (Optional) Project Settings → Auth → SMTP for custom email
